{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tongluc.example/schemas/qa-plan.schema.json",
  "title": "Tổng Lực CDP QA Plan",
  "type": "object",
  "required": ["schema_version", "pages"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "site_url": { "type": "string", "format": "uri" },
    "viewports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "width", "height"],
        "properties": {
          "name": { "type": "string" },
          "width": { "type": "integer", "minimum": 240 },
          "height": { "type": "integer", "minimum": 320 }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string" },
          "path": { "type": "string" },
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "enum": ["selector-exists", "selector-visible", "text-includes", "one-h1", "no-horizontal-overflow"] },
                "selector": { "type": "string" },
                "value": { "type": "string" }
              }
            }
          }
        },
        "anyOf": [ { "required": ["url"] }, { "required": ["path"] } ]
      }
    },
    "navigation_timeout_ms": { "type": "integer", "minimum": 1000 }
    ,
    "screenshots": { "type": "boolean" }
  },
  "additionalProperties": false
}
