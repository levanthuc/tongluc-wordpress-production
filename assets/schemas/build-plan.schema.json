{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tongluc.example/schemas/build-plan.schema.json",
  "title": "Tổng Lực Elementor Build Plan",
  "type": "object",
  "required": ["schema_version", "project", "targets"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "baseline_id": { "type": "string" },
        "baseline_version": { "type": "string" },
        "requested_scope": { "enum": ["SITE", "PAGE", "SECTION", "COMPONENT"] },
        "revision_intent": { "type": "string" }
      },
      "additionalProperties": true
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "expected_post_type", "structure", "operations"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "baseline_role": { "type": "string" },
          "expected_id": { "type": ["integer", "string"] },
          "expected_post_type": { "type": "string", "minLength": 1 },
          "structure": { "type": ["array", "object"] },
          "operations": {
            "type": "object",
            "required": ["verify", "write", "readback"],
            "properties": {
              "verify": { "$ref": "#/$defs/operation" },
              "write": { "$ref": "#/$defs/operation" },
              "regenerate_css": { "$ref": "#/$defs/operation" },
              "readback": { "$ref": "#/$defs/operation" }
            }
          },
          "expect": { "type": "object" }
        },
        "allOf": [
          {
            "anyOf": [
              { "required": ["expected_id"] },
              { "required": ["baseline_role"] }
            ]
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "required": ["ability", "parameters"],
      "properties": {
        "ability": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
